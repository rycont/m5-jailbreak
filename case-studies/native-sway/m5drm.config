output * bg #1a1a1a solid_color
default_border none
exec_always /opt/usr/a/trixie/usr/bin/bash -c "HOME=/opt/usr/a/trixie/root XDG_CONFIG_HOME=/opt/usr/a/trixie/root/.config /opt/usr/a/trixie/usr/bin/foot -f monospace:size=14 -- /opt/usr/a/trixie/usr/bin/bash /tmp/drmfoot.sh"
exec_always /opt/usr/a/trixie/usr/bin/bash -c "QT_QPA_PLATFORM=wayland QT_PLUGIN_PATH=/opt/usr/a/trixie/usr/lib/arm-linux-gnueabihf/qt6/plugins /opt/usr/a/trixie/usr/bin/kcalc"
for_window [app_id="foot"] floating enable, resize set 960 1080, move position 0 0
for_window [app_id="org.kde.kcalc"] floating enable, resize set 960 1080, move position 960 0
